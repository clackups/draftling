# Documents in internal flash instead of a MicroSD card, 4 MB flash.
# Append to a board's SDKCONFIG_DEFAULTS (after its own
# sdkconfig.defaults.<board>), e.g. the seeed_trmnl_75_og_diy
# preset. The board's flash size must be at least 4 MB.
CONFIG_DRAFTLING_STORAGE_FLASH=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_storage_4mb.csv"

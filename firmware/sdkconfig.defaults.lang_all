# "All languages" pack (Linux only): every keyboard layout, input
# method and font of the other packs in one program. The CJK fonts are
# the ja, zh and ko sets merged (linux/tools/merge_cjk_fonts.py). Too
# large for a device's flash: the Kconfig choice exists only for
# IDF_TARGET_LINUX, and idf_ext.py does not offer it.
#
# Applied after linux/sdkconfig.defaults by linux/draftling.mk
# (make PACKS=all), so the explicit layout lines below set every layout.
CONFIG_DRAFTLING_LANG_PACK_ALL=y
CONFIG_KB_LAYOUT_ENABLE_US=y
CONFIG_KB_LAYOUT_ENABLE_UA=y
CONFIG_KB_LAYOUT_ENABLE_DE=y
CONFIG_KB_LAYOUT_ENABLE_FR=y
CONFIG_KB_LAYOUT_ENABLE_HE=y
CONFIG_KB_LAYOUT_ENABLE_DE_CH=y
CONFIG_KB_LAYOUT_ENABLE_FR_CH=y
CONFIG_KB_LAYOUT_ENABLE_IT=y
CONFIG_KB_LAYOUT_ENABLE_PT=y
CONFIG_KB_LAYOUT_ENABLE_ES=y
CONFIG_KB_LAYOUT_ENABLE_GB=y
CONFIG_KB_LAYOUT_ENABLE_SE_FI=y
CONFIG_KB_LAYOUT_ENABLE_NO=y
CONFIG_KB_LAYOUT_ENABLE_DK=y
CONFIG_KB_LAYOUT_ENABLE_PL=y
CONFIG_KB_LAYOUT_ENABLE_CZ=y
CONFIG_KB_LAYOUT_ENABLE_SK=y
CONFIG_KB_LAYOUT_ENABLE_HU=y
CONFIG_KB_LAYOUT_ENABLE_RO=y
CONFIG_KB_LAYOUT_ENABLE_HR=y
CONFIG_KB_LAYOUT_ENABLE_TR=y
CONFIG_KB_LAYOUT_ENABLE_FR_CA=y
CONFIG_KB_LAYOUT_ENABLE_CRH=y
CONFIG_KB_LAYOUT_ENABLE_CRH_B=y
CONFIG_KB_LAYOUT_ENABLE_BR=y
CONFIG_KB_LAYOUT_ENABLE_VI=y
CONFIG_KB_LAYOUT_ENABLE_KO=y
CONFIG_KB_LAYOUT_ENABLE_JA=y
CONFIG_KB_LAYOUT_ENABLE_ZH=y
CONFIG_KB_LAYOUT_ENABLE_TA99=y
CONFIG_KB_LAYOUT_ENABLE_TA_TW=y
CONFIG_KB_LAYOUT_ENABLE_TA_IN=y
CONFIG_KB_LAYOUT_ENABLE_TA_TV=y
CONFIG_KB_LAYOUT_ENABLE_HI_IN=y
CONFIG_KB_LAYOUT_ENABLE_MR_IN=y
CONFIG_KB_LAYOUT_ENABLE_NE_TR=y
CONFIG_KB_LAYOUT_ENABLE_NE_RO=y
CONFIG_KB_LAYOUT_ENABLE_BN_IN=y
CONFIG_KB_LAYOUT_ENABLE_BN_PR=y
CONFIG_KB_LAYOUT_ENABLE_BN_NJ=y
CONFIG_KB_LAYOUT_ENABLE_TE_IN=y
CONFIG_KB_LAYOUT_ENABLE_TE_SA=y
CONFIG_KB_LAYOUT_ENABLE_TE_RTS=y
CONFIG_KB_LAYOUT_ENABLE_TE_PO=y
CONFIG_KB_LAYOUT_ENABLE_TE_AP=y

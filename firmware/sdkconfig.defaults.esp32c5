# ESP32-C5-specific defaults
# Applied automatically when: idf.py set-target esp32c5
#
# Currently the only ESP32-C5 board supported is the
# NiceMCU-C5E-DEV_2.8IPS (XH-C5E_N16R8 module: 16 MB flash, 8 MB quad
# PSRAM). Mirrors sdkconfig.defaults.esp32s3 where the chip allows it.

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# PSRAM (quad SPI is the only mode on the ESP32-C5)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
# Push WiFi/LWIP dynamic allocations to PSRAM to free internal DRAM.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# WiFi: same internal-RAM budget as the ESP32-S3 boards (see
# sdkconfig.defaults.esp32s3 for the reasoning behind each value).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_RX_MGMT_BUF=1
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=6
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n

# The default ESP-IDF main task stack (3.5 KB) is too tight for the
# editor's call chains; match the ESP32-S3 build.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Internal RAM: the ESP32-C5's 320 KB of HP SRAM hold both the code
# placed in RAM and the heap (WiFi / BLE / LVGL internal buffers). The
# WiFi and LWIP "IRAM optimization" options move their hot paths into
# that RAM for throughput that Git sync over HTTPS does not need; keep
# that code in flash and leave the RAM to the heap.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n

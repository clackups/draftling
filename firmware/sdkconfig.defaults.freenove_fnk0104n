# CMakePresets.json board defaults: Freenove FNK0104N
# Sets the hardware model and IDF target used by the "freenove_fnk0104n" preset.

CONFIG_IDF_TARGET="esp32s3"
CONFIG_DRAFTLING_MODEL_FREENOVE_FNK0104N=y

# "SD card via USB" (F1 menu): the board's USB-C connector is wired to
# the ESP32-S3's native USB (GPIO19/20). See components/usb_msc.
CONFIG_TINYUSB_MSC_ENABLED=y
# "Sync via browser" (F1 menu): the Kermit server's USB serial port is
# a TinyUSB CDC-ACM device, not USB-Serial/JTAG, which resets the chip
# when a browser opens the port. See components/kermit.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_RX_BUFSIZE=4096
CONFIG_TINYUSB_CDC_TX_BUFSIZE=4096

# Dynamic CPU frequency scaling (160 MHz when busy, 80 MHz when idle;
# configured by esp_pm_configure() in main.cpp). No light sleep.
CONFIG_PM_ENABLE=y

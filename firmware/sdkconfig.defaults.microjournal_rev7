# CMakePresets.json board defaults: MicroJournal Rev.7 ("Kindred
# Gift"), a LilyGO T5 4.7" E-Paper (ESP32-S3) whose USB-C port is a USB
# host for the built-in QMK keyboard (a Raspberry Pi Pico).
# See https://github.com/unkyulee/micro-journal (rev.7/7.0).
#
# The board does not supply 5 V on its USB-C port: the Rev.7 powers
# the board and the keyboard from its battery boost module through
# VBUS.

CONFIG_IDF_TARGET="esp32s3"
CONFIG_DRAFTLING_MODEL_LILYGO_T5_47_S3=y
# Native USB as a USB keyboard host (with hub support, which the
# option selects). Bluetooth is left out to save battery: the preset
# does not list sdkconfig.defaults.bluetooth, and this keeps it off.
CONFIG_DRAFTLING_USB_HOST_NATIVE=y
CONFIG_BT_ENABLED=n

# USB-OTG host and USB-Serial/JTAG share the S3 internal PHY. Keep the
# console on UART so the USB-OTG controller can own the PHY.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

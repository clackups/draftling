# CMakePresets.json board defaults: LilyGO T5 4.7" E-Paper, ESP32-S3
# version, USB-C port as a USB device.
# Sets the hardware model and IDF target used by the "lilygo_t5_47_s3"
# preset. For the USB-host build see sdkconfig.defaults.microjournal_rev7.

CONFIG_IDF_TARGET="esp32s3"
CONFIG_DRAFTLING_MODEL_LILYGO_T5_47_S3=y

# "SD card via USB" (F1 menu): expose the MicroSD card as a USB Mass
# Storage device over the ESP32-S3's native USB port. See
# components/usb_msc.
CONFIG_TINYUSB_MSC_ENABLED=y
# "Sync via browser" (F1 menu): the Kermit server's USB serial port is
# a TinyUSB CDC-ACM device, not USB-Serial/JTAG, which resets the chip
# when a browser opens the port. See components/kermit.
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_RX_BUFSIZE=4096
CONFIG_TINYUSB_CDC_TX_BUFSIZE=4096

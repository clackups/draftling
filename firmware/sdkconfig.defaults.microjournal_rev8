# CMakePresets.json board defaults: MicroJournal Rev.8 (ESP32-S3-DevKitC-1
# N16R8, 4.2" reflective LCD, built-in matrix keyboard, no MicroSD slot)
# Sets the hardware model and IDF target used by the "microjournal_rev8"
# preset. The preset also appends sdkconfig.defaults.storage_flash_16mb
# (documents in an 8 MB flash partition).

CONFIG_IDF_TARGET="esp32s3"
CONFIG_DRAFTLING_MODEL_MICROJOURNAL_REV8=y

# Built-in keyboard; no Bluetooth keyboard host
# (CONFIG_DRAFTLING_NO_BLUETOOTH).
CONFIG_BT_ENABLED=n

# "Sync via browser" (F1 menu): the Kermit server's USB serial port is a
# TinyUSB CDC-ACM device on the DevKitC-1's native "USB" port. See
# components/kermit. The MSC class is what esp_tinyusb's descriptors
# expect next to it (components/usb_msc); "SD card via USB" itself is
# off with flash storage.
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_RX_BUFSIZE=4096
CONFIG_TINYUSB_CDC_TX_BUFSIZE=4096

# Run the CPU at 80 MHz instead of the default 160 MHz to cut the
# active current on battery. Typing and WiFi do not need more.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_80=y

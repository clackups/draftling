# CMakePresets.json board defaults: Sunton ESP32-8048S043C
# Sets the hardware model and IDF target used by the "sunton_8048s043" preset.

CONFIG_IDF_TARGET="esp32s3"
CONFIG_DRAFTLING_MODEL_SUNTON_8048S043=y

# This board's flash is wired for DIO, overriding the QIO default in
# sdkconfig.defaults.esp32s3. See docs/sunton-esp32-8048S043.md.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y

# Enable the on-board GT911 touchscreen as a secondary input device.
CONFIG_DRAFTLING_TOUCHSCREEN=y

# This author's keyboard is German; enable only US (QWERTY) and DE
# (QWERTZ) layouts and drop the other defaults (all of them are on
# by default in Kconfig, so each needs an explicit override here to
# stay off for this board).
CONFIG_KB_LAYOUT_ENABLE_UA=n
CONFIG_KB_LAYOUT_ENABLE_DE=y
CONFIG_KB_LAYOUT_ENABLE_FR=n
CONFIG_KB_LAYOUT_ENABLE_HE=n
CONFIG_KB_LAYOUT_ENABLE_DE_CH=n
CONFIG_KB_LAYOUT_ENABLE_FR_CH=n
CONFIG_KB_LAYOUT_ENABLE_IT=n
CONFIG_KB_LAYOUT_ENABLE_PT=n
CONFIG_KB_LAYOUT_ENABLE_ES=n
CONFIG_KB_LAYOUT_ENABLE_GB=n
CONFIG_KB_LAYOUT_ENABLE_SE_FI=n
CONFIG_KB_LAYOUT_ENABLE_NO=n
CONFIG_KB_LAYOUT_ENABLE_DK=n
CONFIG_KB_LAYOUT_ENABLE_PL=n
CONFIG_KB_LAYOUT_ENABLE_CZ=n
CONFIG_KB_LAYOUT_ENABLE_SK=n
CONFIG_KB_LAYOUT_ENABLE_HU=n
CONFIG_KB_LAYOUT_ENABLE_RO=n
CONFIG_KB_LAYOUT_ENABLE_HR=n
CONFIG_KB_LAYOUT_ENABLE_TR=n

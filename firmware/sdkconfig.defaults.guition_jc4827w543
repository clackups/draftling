# CMakePresets.json board defaults: Guition JC4827W543C
# Sets the hardware model and IDF target used by the "guition_jc4827w543" preset.

CONFIG_IDF_TARGET="esp32s3"
CONFIG_DRAFTLING_MODEL_GUITION_JC4827W543=y

# The module is an ESP32-S3-WROOM-1-N4R8 (4 MB flash, 8 MB octal
# PSRAM). Override the 16 MB flash size and the shared partition table
# (whose 14 MB factory partition does not fit) -- see
# partitions_4mb.csv.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_4mb.csv"

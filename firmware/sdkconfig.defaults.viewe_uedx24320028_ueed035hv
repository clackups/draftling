# CMakePresets.json board defaults: Viewe UEDX24320028E-WB-A board with
# the UEED035HV-RX40-L001 3.5" transflective display attached
# Sets the hardware model and IDF target used by the "viewe_uedx24320028_ueed035hv" preset.

CONFIG_IDF_TARGET="esp32s3"
CONFIG_DRAFTLING_MODEL_VIEWE_UEDX24320028_UEED035HV=y

# "SD card via USB" (F1 menu): expose the on-board MicroSD as a USB
# Mass Storage device over the ESP32-S3's native USB port (the V1.1
# board routes its USB-C connector straight to GPIO19/20). See
# components/usb_msc.
CONFIG_TINYUSB_MSC_ENABLED=y

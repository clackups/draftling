# CMakePresets.json board defaults: Waveshare ESP32-S3-LCD-3.16
# Sets the hardware model and IDF target used by the "waveshare_lcd_316" preset.

CONFIG_IDF_TARGET="esp32s3"
CONFIG_DRAFTLING_MODEL_WAVESHARE_LCD_316=y

# "SD card via USB" (F1 menu): expose the on-board MicroSD as a USB
# Mass Storage device over the ESP32-S3's native USB port (the board's
# USB-C connector is wired to it; it enumerates as a USB CDC serial
# port for flashing). See components/usb_msc.
CONFIG_TINYUSB_MSC_ENABLED=y

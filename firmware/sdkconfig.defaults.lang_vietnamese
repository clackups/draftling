# Vietnamese language pack: US-English and Vietnamese (Telex input),
# with the Vietnamese letters of the Greybeard / Noto Sans Mono fonts.
#
# Applied after sdkconfig.defaults and the board's own defaults by
# "idf.py --preset <board> --lang-pack vietnamese" (see idf_ext.py and
# BUILDING.md), so the explicit layout lines below override any board
# that picks its own layout set.
CONFIG_DRAFTLING_LANG_PACK_VIETNAMESE=y
CONFIG_KB_LAYOUT_ENABLE_US=y
CONFIG_KB_LAYOUT_ENABLE_UA=n
CONFIG_KB_LAYOUT_ENABLE_DE=n
CONFIG_KB_LAYOUT_ENABLE_FR=n
CONFIG_KB_LAYOUT_ENABLE_HE=n
CONFIG_KB_LAYOUT_ENABLE_DE_CH=n
CONFIG_KB_LAYOUT_ENABLE_FR_CH=n
CONFIG_KB_LAYOUT_ENABLE_IT=n
CONFIG_KB_LAYOUT_ENABLE_PT=n
CONFIG_KB_LAYOUT_ENABLE_ES=n
CONFIG_KB_LAYOUT_ENABLE_GB=n
CONFIG_KB_LAYOUT_ENABLE_SE_FI=n
CONFIG_KB_LAYOUT_ENABLE_NO=n
CONFIG_KB_LAYOUT_ENABLE_DK=n
CONFIG_KB_LAYOUT_ENABLE_PL=n
CONFIG_KB_LAYOUT_ENABLE_CZ=n
CONFIG_KB_LAYOUT_ENABLE_SK=n
CONFIG_KB_LAYOUT_ENABLE_HU=n
CONFIG_KB_LAYOUT_ENABLE_RO=n
CONFIG_KB_LAYOUT_ENABLE_HR=n
CONFIG_KB_LAYOUT_ENABLE_TR=n
CONFIG_KB_LAYOUT_ENABLE_FR_CA=n
CONFIG_KB_LAYOUT_ENABLE_VI=y

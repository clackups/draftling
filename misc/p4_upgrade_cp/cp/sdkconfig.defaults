# Common to every board; the target, flash and partition table are in
# sdkconfig.defaults.<board>.

# ESP-Hosted co-processor for an MCU host (an ESP32-P4), RPC
# dialect V2 (the "RPCRsp" / "RPCEvt" endpoints every MCU host speaks).
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_CP=y
CONFIG_ESP_HOSTED_CP_FOR_MCU=y
CONFIG_ESP_HOSTED_CP_RPC_V2=y

# SDIO link to the P4. Packet mode works with a stock ESP-IDF (the
# default software aggregation needs a patched IDF) and with hosts of
# every esp-hosted generation.
CONFIG_EH_TRANSPORT_CP_SDIO=y
CONFIG_EH_TRANSPORT_CP_SDIO_MODE_PACKET=y

# Wi-Fi (Git sync) and the BLE controller (keyboard) on the co-processor; the
# Bluedroid host stack runs on the P4 over hosted HCI.
CONFIG_ESP_HOSTED_CP_FEAT_WIFI=y
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n
CONFIG_ESP_HOSTED_CP_FEAT_BT=y
CONFIG_ESP_HOSTED_CP_BT_ENABLED=y
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_LE_SLEEP_ENABLE=y
CONFIG_BT_LE_HCI_INTERFACE_USE_RAM=y
CONFIG_ESP_WIFI_NVS_ENABLED=y

# Co-processor OTA from the host is always built in (system feature).

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_CACHE_MALLOC=y
# Optimize for size: the image must fit the smallest OTA slot the
# co-processor may have (CP_MAX_APP_SIZE).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# Kconfig root for the online demo build (online_demo/tools/gen_sdkconfig.py).
#
# The firmware's own Kconfig.projbuild files are evaluated exactly as
# ESP-IDF would, with the board's sdkconfig.defaults.<board> applied, so
# the demo gets the same CONFIG_DRAFTLING_* / CONFIG_KB_LAYOUT_* values
# as the real Freenove FNK0104S build. The few ESP-IDF / LVGL symbols
# those files depend on are declared here.

mainmenu "Draftling online demo"

config IDF_TARGET
    string
    default "esp32s3"

config IDF_TARGET_ESP32S3
    bool
    default y

config IDF_TARGET_ESP32P4
    bool

config IDF_TARGET_ESP32C5
    bool

config IDF_TARGET_ESP32C61
    bool

config SOC_PARLIO_LCD_SUPPORTED
    bool

config LV_USE_BIDI
    bool
    default y

source "$(DRAFTLING_FIRMWARE)/main/Kconfig.projbuild"
source "$(DRAFTLING_FIRMWARE)/components/kb_layout/Kconfig.projbuild"
source "$(DRAFTLING_FIRMWARE)/components/editor/Kconfig.projbuild"

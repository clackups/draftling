# ESP32-C5-specific defaults
# Applied automatically when: idf.py set-target esp32c5
#
# Currently the only ESP32-C5 board supported is the RockBase
# NM-CYD-C5 (ESP32-C5-WROOM-1, 16MB flash + 8MB PSRAM).

CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# PSRAM -- ESP32-C5 silicon only supports Quad-mode PSRAM (no Octal
# mode like the ESP32-S3).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Bluetooth -- ESP-IDF's Bluedroid host on ESP32-C5 currently supports
# BLE only (no Classic BT profile support in ESP-IDF, even though the
# ESP32-C5 silicon datasheet advertises a Classic-capable radio).
# ble_keyboard.cpp only ever uses the BLE HID host, so this matches
# every other supported board.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_GATTC_ENABLE=y
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y
CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y
CONFIG_BT_BLE_SMP_ENABLE=y
CONFIG_BT_HID_HOST_ENABLED=y

# WiFi -- match the ESP32-S3 tuning (see sdkconfig.defaults.esp32s3
# for the full rationale): keep static RX buffers small and push the
# rest of the WiFi/LWIP allocations to PSRAM.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_DYNAMIC_RX_MGMT_BUF=1
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=6
CONFIG_ESP_WIFI_AMPDU_TX_ENABLED=n
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n
